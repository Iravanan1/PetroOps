{
  "appId": "com.petroops.app",
  "productName": "PetroOps",
  "copyright": "Copyright © 2025 PetroOps. All rights reserved.",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build-resources"
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/**/*"
  ],
  "files": [
    "dist/**/*",
    "electron.cjs",
    "preload.cjs",
    "package.json",
    "!dist/**/*.map"
  ],
  "extraResources": [
    {
      "from": "server-dist/",
      "to": "server/",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.business",
    "icon": "build-resources/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build-resources/entitlements.mac.plist",
    "entitlementsInherit": "build-resources/entitlements.mac.plist",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ]
  },
  "win": {
    "icon": "build-resources/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "linux": {
    "icon": "build-resources/icon.png",
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb",      "arch": ["x64"] }
    ],
    "category": "Office"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PetroOps",
    "installerIcon": "build-resources/icon.ico",
    "uninstallerIcon": "build-resources/icon.ico",
    "installerHeaderIcon": "build-resources/icon.ico"
  },
  "dmg": {
    "title": "PetroOps ${version}",
    "icon": "build-resources/icon.icns",
    "window": { "width": 540, "height": 380 }
  },
  "protocols": [
    {
      "name": "PetroOps Protocol",
      "schemes": ["petroops"],
      "role": "Editor"
    }
  ],
  "publish": [
    {
      "provider": "generic",
      "url": "https://releases.petroops.in/desktop/${os}/${arch}"
    }
  ]
}