{
  "name": "petroops",
  "productName": "PetroOps",
  "description": "PetroOps — AI-Assisted Petroleum Operations",
  "version": "1.0.0",
  "main": "electron.cjs",
  "scripts": {
    "dev": "tsx server/server.ts",
    "start": "tsx server/server.ts",
    "build": "vite build && tsc --outDir dist/server -p tsconfig.server.json && mkdir -p server-dist && cp -r dist/server/* server-dist/ 2>/dev/null || true && node scripts/post-build.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-desktop server-dist",
    "lint": "tsc --noEmit",
    "electron:dev": "NODE_ENV=development electron electron.cjs",
    "electron:build": "node scripts/generate-icons.js && npm run build && electron-builder --config electron-builder.json",
    "electron:pack-mac": "node scripts/generate-icons.js && npm run build && electron-builder --mac --config electron-builder.json",
    "electron:pack-win": "node scripts/generate-icons.js && npm run build && electron-builder --win --config electron-builder.json",
    "cap:add-android": "npx cap add android",
    "cap:add-ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "migration:run": "tsx run-migration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@google-cloud/vision": "^5.3.6",
    "@google/genai": "^1.52.0",
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.39.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.10",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^10.3.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "retry": "^0.13.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "prisma": "^5.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
